      "@id": "https://kimq.tech/san-pham/nhatdat/huong-dan#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "### Hệ thống có thay nhận định của thẩm định viên không?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Không. Hệ thống giữ căn cứ để kiểm tra; thẩm định viên đối chiếu theo nghiệp vụ của doanh nghiệp."
          }
        },
        {
          "@type": "Question",
          "name": "### Đơn giá UBND khác đơn giá tham chiếu thị trường thế nào?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Đơn giá UBND do nhà nước quy định cho đoạn; đơn giá tham chiếu thị trường được tính từ tài sản so sánh."
          }
        },
        {
          "@type": "Question",
          "name": "### Xuất Excel theo mẫu nào?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Theo các mẫu đã triển khai; mẫu riêng của công ty trao đổi với KimQ."
          }
