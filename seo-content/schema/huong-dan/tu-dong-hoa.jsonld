    {
      "@type": "FAQPage",
      "@id": "https://kimq.tech/san-pham/tu-dong-hoa/huong-dan#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "### Có bao giờ một đơn bị xuất hai hoá đơn không?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Không. Mỗi lần phát hành đều kiểm mã đơn đã có hoá đơn chưa và dùng mã đơn làm khoá chống trùng. Số hoá đơn được lưu trước khi gửi email, nên lỗi email hay khởi động lại máy chủ cũng không tạo hoá đơn thứ hai."
          }
        },
        {
          "@type": "Question",
          "name": "### Khách quên ghi mã đơn khi chuyển khoản thì sao?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Hệ thống không tự đoán đơn nào, vì gán nhầm tiền khó gỡ hơn nhiều so với để người gán. Giao dịch đó nằm trong bảng lệch của lần đối soát kế tiếp; kế toán đọc nội dung chuyển khoản và gán đúng đơn."
          }
        },
        {
          "@type": "Question",
          "name": "### Hoá đơn gửi lỗi mãi thì có bị bỏ quên không?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Hệ thống thử lại tối đa 8 lần trong chừng 2 giờ. Vẫn lỗi thì việc dừng lại và đơn hiện ở nhóm Missing invoice trong tệp đối soát, nên kế toán thấy và phát hành bù ở kỳ đối soát kế tiếp."
          }
        },
        {
          "@type": "Question",
          "name": "### Dùng được với phần mềm hoá đơn nào?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Phần mềm hoá đơn điện tử có kết nối API. KimQ chạy luồng này với MISA cho các sản phẩm của chính mình."
          }
        },
        {
          "@type": "Question",
          "name": "### AI có tự sửa hệ thống đang chạy không?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "AI điều tra và chuẩn bị bản sửa kèm kiểm thử. Bản sửa được hợp nhất theo quy tắc đặt cho từng hệ thống: cần duyệt thì chờ kỹ sư duyệt; cho tự hợp nhất thì chỉ hợp nhất khi kiểm thử đạt. Dữ liệu thật, khoá bí mật và cấu hình thanh toán không bao giờ tự đổi."
          }
        },
        {
          "@type": "Question",
          "name": "### Đối soát có sửa dữ liệu không?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Không. Công cụ đối soát chỉ đọc ba nguồn và xuất tệp Excel. Việc phát hành bù hay gán tiền cho đơn do kế toán làm riêng sau khi xem tệp."
          }
        }
      ]
    }
  ]
