      "@type": "FAQPage",
      "@id": "https://kimq.tech/san-pham/thong-tin-dau-thau/huong-dan#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "### Các con số trên trang có phải tin còn hạn không?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Không. Đó là số bản ghi trong kho, gồm cả tin đã đóng; danh sách tìm kiếm cho phép lọc tin còn hạn."
          }
        },
        {
          "@type": "Question",
          "name": "### Giá trúng có cho mọi gói và tài sản không?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Không. Giá trúng và phân tích phụ thuộc dữ liệu kết quả thu thập được; không dùng giá tham chiếu thay cho giá trúng của chính tin đang xem."
          }
        },
        {
          "@type": "Question",
          "name": "### Dùng trên điện thoại hay qua trợ lý được không?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Được. Giao diện web có danh sách gói thầu, đấu giá và mục đã lưu trên điện thoại; bộ công cụ cho trợ lý hỗ trợ tìm tin, đọc chi tiết, tra giá, kiểm hồ sơ và quản lý theo dõi."
          }
        }
      ]
    }
  ]
