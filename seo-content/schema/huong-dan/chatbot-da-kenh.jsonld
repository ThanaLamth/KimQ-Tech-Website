    {
      "@type": "FAQPage",
      "@id": "https://kimq.tech/san-pham/chatbot-da-kenh/huong-dan#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "### Trợ lý có tự bịa giá hay hứa hẹn không?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Không. Không tìm được căn cứ, hoặc câu hỏi chạm tới tiền, hoàn tiền, khiếu nại thì trợ lý chuyển người."
          }
        },
        {
          "@type": "Question",
          "name": "### Có cần lập trình hay đổi phần mềm không?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Không. Kênh nối bằng tài khoản Fanpage, OA, website hiện có. Muốn tra đơn trên hệ thống riêng, KimQ viết kết nối chỉ đọc cho đúng hệ thống đó."
          }
        },
        {
          "@type": "Question",
          "name": "### Dữ liệu khách có lộ qua chat không?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tra đơn chỉ trả mã, trạng thái thanh toán và đường dẫn kết quả; đường dẫn gửi vào email chủ đơn, không gửi trong chat."
          }
        },
        {
          "@type": "Question",
          "name": "### Trợ lý có nói rõ là tự động không?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Có. Câu chào luôn nói rõ đây là trợ lý tự động."
          }
        }
      ]
    }
