      "mainEntity": [
        {
          "@type": "Question",
          "name": "### Phòng khám có phải bỏ phần mềm đang dùng không?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Không. Bộ máy nối HIS, chấm công và MISA Kế toán hiện có."
          }
        },
        {
          "@type": "Question",
          "name": "### Hệ thống có tự phê duyệt bảng lương không?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Không. Phê duyệt bảng lương là việc của người."
          }
        },
        {
          "@type": "Question",
          "name": "### Khi HIS chưa có API thì sao?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Dữ liệu có thể lấy qua tệp XML chuẩn của Bộ Y tế và báo cáo Excel xuất theo lịch hằng ngày."
          }
        }
      ]
