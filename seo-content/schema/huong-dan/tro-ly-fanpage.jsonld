      "@type": "FAQPage",
      "@id": "https://kimq.tech/san-pham/tro-ly-fanpage/huong-dan#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Có phải giao mật khẩu fanpage không?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Không. Bạn cấp quyền cho trang qua màn hình kết nối của Meta và thu hồi được bất kỳ lúc nào trong cài đặt của trang."
          }
        },
        {
          "@type": "Question",
          "name": "Đăng được lên những đâu?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Facebook Page theo quyền trang bạn cấp; hỗ trợ đăng kèm lên Instagram và Threads của doanh nghiệp."
          }
        },
        {
          "@type": "Question",
          "name": "Ảnh và video lấy từ đâu?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ảnh tạo theo màu và phong cách thương hiệu hoặc chỉnh từ ảnh sản phẩm bạn có; video dọc ngắn làm bằng AI Studio."
          }
        },
        {
          "@type": "Question",
          "name": "Giá và thông tin sản phẩm trong bài có đúng không?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Lấy từ dữ liệu bạn cung cấp; chỗ không chắc được đánh dấu để người duyệt kiểm."
          }
        }
      ]
