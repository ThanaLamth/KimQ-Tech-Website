    {
      "@type": "FAQPage",
      "@id": "https://kimq.tech/san-pham/kho-gia-vat-lieu/huong-dan#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Vì sao kho còn hàng nhưng đơn vẫn thiếu?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Kiểm tra Tự do và Đã giữ theo đúng lô, kho và mặt hàng. Hàng đã giữ cho đơn khác không nằm trong phần có thể hứa cho đơn mới."
          }
        },
        {
          "@type": "Question",
          "name": "Giá giữa các hãng có so trực tiếp được không?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Chọn cùng nhóm hàng, quy cách, bề mặt, tỉnh và kỳ. Đọc đơn vị và trạng thái VAT, rồi tra lại nguồn."
          }
        },
        {
          "@type": "Question",
          "name": "Nhập tệp có ghi ngay vào hệ thống không?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Không. Bạn chọn tệp, xem trước, kiểm tra lỗi rồi mới xác nhận ghi."
          }
        },
        {
          "@type": "Question",
          "name": "Xoá một lần nhập có ảnh hưởng dữ liệu giá không?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Có. Mọi dòng giá của lô nhập đó bị xoá; hãy kiểm tra đúng lô trước khi thao tác."
          }
        },
        {
          "@type": "Question",
          "name": "Đề xuất của trợ lý được xử lý ở đâu?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Xem mục Chờ duyệt và kiểm tra nội dung đề xuất trước khi người có quyền phê duyệt."
          }
        }
      ]
    }
