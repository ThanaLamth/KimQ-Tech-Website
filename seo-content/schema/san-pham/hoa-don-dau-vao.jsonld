    {
      "@type": "FAQPage",
      "@id": "https://kimq.tech/san-pham/hoa-don-dau-vao#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Nhập hoá đơn bằng cách nào?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tải tệp XML hoá đơn điện tử hoặc bảng Excel, hệ thống tự khớp tên cột. Hoá đơn đã có sẽ không bị nhập trùng."
          }
        },
        {
          "@type": "Question",
          "name": "Căn cứ pháp lý có đáng tin không?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Mỗi quy tắc ghi số hiệu văn bản, điều khoản, ngày hiệu lực và liên kết văn bản gốc để bạn tự đọc lại."
          }
        },
        {
          "@type": "Question",
          "name": "Có tra trạng thái hoá đơn trên cổng thuế không?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Không. Hệ thống không tra cổng thuế, không xác thực chữ ký số và không nộp tờ khai. Trợ lý nhắc bạn tự tra."
          }
        },
        {
          "@type": "Question",
          "name": "Thư gửi người bán có tự gửi đi không?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Không. Chỉ có bản nháp; kế toán tự gửi từ email của mình."
          }
        },
        {
          "@type": "Question",
          "name": "Đối chiếu ba chiều cần những gì?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Đơn mua và phiếu nhập kho, nhập từ Excel. Hệ thống so số lượng, đơn giá từng dòng trong dung sai bạn đặt."
          }
        },
        {
          "@type": "Question",
          "name": "Dùng trên điện thoại được không?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Được. Mọi màn hình làm cho điện thoại trước; máy tính thấy cả kỳ trên một bảng."
          }
        }
      ]
    }
  ]
