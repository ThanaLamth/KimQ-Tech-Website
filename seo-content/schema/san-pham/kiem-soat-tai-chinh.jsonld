    {
      "@type": "FAQPage",
      "@id": "https://kimq.tech/san-pham/kiem-soat-tai-chinh#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Phần mềm có kết luận gian lận không?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Không. Phần mềm chỉ nêu tín hiệu và gom bằng chứng; tín hiệu không phải phát hiện, phát hiện không phải gian lận. Người có thẩm quyền kết luận."
          }
        },
        {
          "@type": "Question",
          "name": "Có thay phần mềm kế toán không?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Không. Dữ liệu được nạp từ sổ sách, báo cáo và giao dịch hiện có, hoặc đọc từ phần mềm kế toán ở chế độ chỉ đọc; phần mềm chỉ kiểm tra và theo dõi khắc phục."
          }
        },
        {
          "@type": "Question",
          "name": "Lần nạp sai thì sao?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Mỗi lần nạp bật/tắt được; tắt thì các dòng đó rời khỏi mọi phân tích, không phải xoá dữ liệu."
          }
        },
        {
          "@type": "Question",
          "name": "Số tiền gắn cờ có phải là thiệt hại không?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Không. Đó là số tiền cần rà soát, tách riêng với mức độ và độ tin cậy."
          }
        },
        {
          "@type": "Question",
          "name": "Dữ liệu có lộ ra ngoài không?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Dữ liệu dùng để phân tích được khử định danh; quyền xem và thao tác chia theo sáu vai, kiểm ở máy chủ."
          }
        },
        {
          "@type": "Question",
          "name": "Dùng trên điện thoại được không?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Được. Màn hình dưới 820px dùng bản điện thoại để xem tổng quan, vấn đề và đầu việc; nạp dữ liệu làm trên máy tính."
          }
        }
      ]
    }
  ]
