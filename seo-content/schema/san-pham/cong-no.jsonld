    {
      "@type": "FAQPage",
      "@id": "https://kimq.tech/san-pham/cong-no#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Hệ thống có tự ghi sổ hay tự gửi thư cho khách không?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Không. Mọi thao tác ghi đều qua bước xem trước và người có quyền duyệt. Thư nhắc là bản nháp, người phụ trách tự gửi."
          }
        },
        {
          "@type": "Question",
          "name": "Sao kê của ngân hàng nào cũng nhập được?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tệp Excel hoặc CSV sao kê, có tệp mẫu để khớp cột. Giao dịch đã nhập sẽ không bị nhập trùng."
          }
        },
        {
          "@type": "Question",
          "name": "Công nợ đang nằm trong nhiều file Excel, chuyển sang thế nào?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nhập từ Excel, hệ thống kiểm từng dòng trước khi ghi. Từ đó mọi người làm trên một sổ chung."
          }
        },
        {
          "@type": "Question",
          "name": "Nhân viên kinh doanh xem được gì?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Chỉ khách mình phụ trách: hoá đơn phải thu, tuổi nợ, thư nhắc nháp. Không thấy phải trả, sao kê, dòng tiền."
          }
        },
        {
          "@type": "Question",
          "name": "Dòng tiền 13 tuần có chắc chắn không?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Đây là dự báo theo hạn hoá đơn đã ghi sổ, không phải cam kết. Có thể chọn giả định khách trả trễ để xem kịch bản xấu."
          }
        },
        {
          "@type": "Question",
          "name": "Dùng trên điện thoại được không?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Được. Mọi màn hình làm cho điện thoại trước, máy tính thấy thêm chi tiết. Có thể hỏi qua Zalo."
          }
        }
      ]
    }
