    {
      "@type": "FAQPage",
      "@id": "https://kimq.tech/san-pham/tro-ly-fanpage#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Có bài nào tự lên trang khi chưa duyệt không?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Không. Bài nháp, ảnh và giờ đăng chờ ở hàng duyệt; chỉ người được giao quyền duyệt mới đưa bài vào lịch đăng."
          }
        },
        {
          "@type": "Question",
          "name": "Đăng lên những kênh nào?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Facebook Page qua kết nối chính thức của Meta, theo quyền trang bạn cấp; hỗ trợ đăng kèm lên Instagram và Threads của doanh nghiệp."
          }
        },
        {
          "@type": "Question",
          "name": "Có phải giao mật khẩu fanpage không?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Không. Bạn cấp quyền cho trang qua màn hình kết nối của Meta và có thể thu hồi bất kỳ lúc nào trong phần cài đặt của trang."
          }
        },
        {
          "@type": "Question",
          "name": "Ảnh lấy từ đâu?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ảnh tạo bằng AI theo màu và phong cách thương hiệu, hoặc chỉnh từ ảnh sản phẩm bạn có sẵn. Video dọc ngắn làm bằng AI Studio."
          }
        },
        {
          "@type": "Question",
          "name": "Giá và thông tin sản phẩm trong bài có đúng không?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Giá, thông số, ưu đãi lấy từ dữ liệu bạn cung cấp; chỗ AI không chắc được đánh dấu để người duyệt kiểm."
          }
        },
        {
          "@type": "Question",
          "name": "Bình luận khó hoặc khiếu nại thì sao?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Trợ lý chỉ gợi ý hoặc trả lời câu hỏi thường gặp theo nội dung đã duyệt; khiếu nại, câu hỏi khó và đơn hàng được chuyển cho người phụ trách."
          }
        }
      ]
    }
  ]
