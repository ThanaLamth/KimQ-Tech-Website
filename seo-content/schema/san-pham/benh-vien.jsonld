    {
      "@type": "FAQPage",
      "@id": "https://kimq.tech/san-pham/benh-vien#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Dữ liệu bệnh nhân lưu ở đâu?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Dữ liệu gốc vẫn nằm trong HIS của bệnh viện; ứng dụng chỉ hiển thị phần bệnh viện đã phát hành cho đúng bệnh nhân."
          }
        },
        {
          "@type": "Question",
          "name": "Bệnh nhân có thấy hồ sơ của người khác không?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Không. Mỗi bệnh nhân chỉ thấy hồ sơ của mình và hồ sơ người thân đã được cấp quyền."
          }
        },
        {
          "@type": "Question",
          "name": "Trợ lý AI có chẩn đoán bệnh không?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Không. Trợ lý chỉ giải thích thuật ngữ trên kết quả đã phát hành, dẫn nguồn và khuyên trao đổi với bác sĩ."
          }
        },
        {
          "@type": "Question",
          "name": "Một bệnh viện nhiều cơ sở dùng chung được không?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Được. Một nền cho nhiều cơ sở, mỗi cơ sở cấu hình nhận diện riêng."
          }
        },
        {
          "@type": "Question",
          "name": "Đăng nhập thế nào?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Bằng số điện thoại và mã OTP; nhập sai nhiều lần thì khoá tạm để chống dò mã."
          }
        },
        {
          "@type": "Question",
          "name": "Lịch đặt trên ứng dụng có chắc chắn không?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Lịch chỉ được xác nhận khi hệ thống bệnh viện phản hồi; trạng thái Đã xác nhận hay Đã huỷ cập nhật theo HIS."
          }
        }
      ]
    }
  ]
